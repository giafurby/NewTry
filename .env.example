# =============================================================================
#  NewTry – Einstellungen. install.sh legt die echte .env automatisch an und übernimmt die Schlüssel
#  aus dem alten Bot (/root/trading-bot/.env). Die .env NIE ins Repository hochladen (steht in .gitignore).
# =============================================================================

# live  = echtes Geld auf Binance Spot
# paper = Simulation mit echten Binance-Kursen (Konto in data/paper_wallet.json)
MODE=paper

# Binance-API-Schlüssel: NUR „Spot-Handel“ erlauben, Auszahlungen AUS, IP-Freigabe nur für den Server
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram (Bot-Token von @BotFather, Chat-ID von @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mit dieser Währung kauft der Bot (muss auf dem Binance-Konto liegen)
QUOTE=USDC

# Beobachtete Coins. Coins ohne Markt gegen QUOTE werden beim Start automatisch übersprungen.
COINS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,TRX,LTC,LINK,AVAX,DOT,ATOM,ETC,XLM,NEAR,UNI,FIL,APT,ARB,OP,SUI,HBAR,AAVE,ALGO

# --- Regel 1: Trend (4h-Ausbruch) ------------------------------------------------
# So viel % des Kapitals darf ein Trend-Trade bis zum Stop verlieren (0,1 bis 3)
RISK_PER_TRADE_PCT=1.0
# Höchstens so viele Trend-Positionen gleichzeitig
MAX_POSITIONS=3
# Höchstens so viel % des Kapitals in einer Trend-Position
MAX_POSITION_PCT=33

# --- Regel 2: Crash-Kauf (nach −9 % in 4 Stunden kaufen, nach 4 Stunden verkaufen) -----
DIP_ENABLED=true
# Nur die großen Coins, auf denen die Regel geprüft wurde
DIP_COINS=BTC,ETH,SOL,BNB,XRP,TRX,DOGE,ZEC,ADA,BCH
DIP_DROP_PCT=9
DIP_POSITION_PCT=20
# Höchstens 3 gleichzeitig: bei einem marktweiten Crash (März 2020) nie mehr als 60 % des Kapitals im Fall
DIP_MAX_POSITIONS=3
DIP_STOP_PCT=15
DIP_HOLD_HOURS=4
# Nach einem Notstop 24 h kein neuer Crash-Kauf in diesem Coin (Schutz vor Totalabstürzen wie LUNA)
DIP_COOLDOWN_HOURS=24

# --- Notbremse bei Binance ----------------------------------------------------------
# Nach jedem Kauf eine Stop-Order direkt bei Binance (verkauft auch, wenn Bot oder Server ausfallen)
EXCHANGE_STOP=true
# Sie löst so viel % unter dem Stop des Bots aus (läuft der Bot, verkauft er vorher selbst)
EXCHANGE_STOP_BUFFER_PCT=1.0
# Mindestpreis so viel % unter dem Auslöser (Binance kennt für die meisten Coins nur Stop-Orders mit Mindestpreis)
EXCHANGE_STOP_GAP_PCT=3.0

# --- Grenzen für alles -------------------------------------------------------------
# Fällt das Kapital so viel % unter den Höchststand: alles verkaufen und anhalten (weiter mit /weiter).
# Im Rückblick 2017–2026 lag der größte Rückgang bei 26 %; 40 % heißt: Hier stimmt etwas grundsätzlich nicht mehr.
MAX_DRAWDOWN_PCT=40
# Tageslimit (keine neuen Käufe nach so viel % Tagesverlust). 0 = aus. Bewusst aus: Es würde genau die
# Crash-Käufe blockieren, die im Rückblick das Geld verdient haben.
DAILY_LOSS_LIMIT_PCT=0

# --- Sonstiges ----------------------------------------------------------------
# Einmaliger Funktionstest beim ersten Echtgeld-Start: Kauf und sofortiger Verkauf für ca. 7 USDC
SELFTEST_TRADE=true
# Nach jeder 4h-Prüfung eine stille Telegram-Nachricht (auch ohne Kaufsignal)
SCAN_REPORTS=true
# Uhrzeit des Tagesberichts
REPORT_HOUR=9
TIMEZONE=Europe/Berlin
# Startguthaben im Papiermodus
PAPER_START_BALANCE=150
